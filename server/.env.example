NODE_ENV=development
PORT=3000
# Neon/hosted Postgres: keep ?sslmode=require. If you get a SCRAM/channel binding error, remove &channel_binding=require
DATABASE_URL=postgresql://syncpad_app:CHANGE_ME@localhost:5432/syncpad
# 32+ random chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Public https URL in production (no trailing slash)
SITE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Session lengths
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30
# Optional
REDIS_URL=
PG_POOL_MAX=10
RUN_MIGRATIONS=true
